# LLM API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Configuration
LLM_PROVIDER=openai  # openai or anthropic
LLM_MODEL=gpt-4-turbo-preview

# Postman Integration
POSTMAN_API_KEY=your-postman-api-key-here
POSTMAN_WORKSPACE_ID=your-workspace-id

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RedisVL Configuration
REDISVL_INDEX_NAME=valipilot_vectors
REDISVL_VECTOR_DIM=1536

# Telnyx (Optional - for SMS alerts)
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_FROM_NUMBER=+1234567890
TELNYX_TO_NUMBER=+1234567890

# Luma (Optional - for scheduling)
LUMA_API_KEY=your-luma-api-key-here

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
CONFIDENCE_THRESHOLD=0.75
MAX_RETRIES=3
